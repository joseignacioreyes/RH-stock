# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a GitHub.
# En Vercel, estas mismas variables se cargan en: Proyecto → Settings → Environment Variables.
# Las que empiezan con NEXT_PUBLIC_ se ven en el navegador: nunca pongas claves secretas en ellas.
# Paso a paso para conseguir cada valor: docs/fase-0-cuentas.md

# Dirección pública de la app (para los enlaces al compartir). En tu computador: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://rhstock.cl

# Supabase (base de datos, inicio de sesión y fotos) → Project Settings → API Keys. Se usa desde la Fase 1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: da acceso total a la base de datos. Solo en el servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Clave del negocio de ejemplo (Almacén Don Pepe), para "Probar sin registrarse". SECRETA.
# En tu computador puede ser Demo1234. En Vercel usa una clave larga al azar (nadie necesita saberla).
DEMO_CLAVE=

# API de Claude para leer boletas y comprobantes → platform.claude.com → API Keys. Se usa desde la Fase 3. SECRETA.
ANTHROPIC_API_KEY=
# SOLO para desarrollo sin clave de la API: "ejemplo" lee siempre la boleta de ejemplo. Nunca ponerla en Vercel.
# LECTOR_BOLETAS=ejemplo

# WhatsApp de soporte y ventas: solo números, con el 56 adelante. Se cambia aquí y en Vercel.
NEXT_PUBLIC_WHATSAPP_SOPORTE=56977766584

# Clave para las tareas programadas de Vercel (vercel.json): una clave larga inventada. SECRETA.
# Vercel la envía sola a /api/cron/... si la pones en Environment Variables.
CRON_SECRET=
